# Copy this file to .env and fill in real values

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
# Local:      mongodb://127.0.0.1:27017/attendance_system
# Atlas:      mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/attendance_system
MONGO_URI=mongodb://127.0.0.1:27017/attendance_system

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Work day rules
STANDARD_WORK_HOURS=8
LATE_AFTER=09:15
DEFAULT_ANNUAL_LEAVE_DAYS=18

# Default admin account created by `npm run seed:admin`
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@innereye.com
ADMIN_PASSWORD=Admin@12345
